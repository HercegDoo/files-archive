{
  "Defaults": {
    "MaxLogSizeMB": 12.0,
    "LogRotateCount": 3,
    "OlderThanSeconds": 60.0,
    "DateField": "CreationTime",
    "Extensions": [".txt", ".pdf"],
    "MaxDepth": 3,
    "MaxFilesPerRun": 100,
    "DeleteEmptyFolders": true,
    "ProtectedEmptyFolders": ["templates/**", "!templates/tmp"],
    "ArchiveFolder": "Archive/{year}/{month}",
    "ArchiveZipEnabled": true,
    "ArchiveZipAfter": "1 year",
    "ArchiveZipGroupBy": "month",
    "RetentionEnabled": true,
    "RetentionYears": 7.0,
    "RetentionAction": "move",
    "SecondaryStorage": "Secondary",
    "TestMode": false
  },
  "Targets": [
    {
      "Name": "InvoicesEdited",
      "Path": "data/InvoicesEdited",
      "Enabled": true,
      "ArchiveFolder": "../ArchiveEdited/{year}",
      "OlderThanSeconds": 120.0,
      "Extensions": [".txt"],
      "MaxDepth": 1,
      "DeleteEmptyFolders": true,
      "ProtectedEmptyFolders": ["keep-edited"]
    },
    {
      "Name": "DisabledSource",
      "Path": "data/Disabled",
      "Enabled": false
    }
  ]
}
