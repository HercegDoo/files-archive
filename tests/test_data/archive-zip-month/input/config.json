{
  "Defaults": {
    "MaxLogSizeMB": 5,
    "LogRotateCount": 2,
    "OlderThanSeconds": 86400,
    "DateField": "LastWriteTime",
    "Extensions": [".txt"],
    "ArchiveFolder": "../Archive/{year}/{month}",
    "archive_zip_enabled": true,
    "archive_zip_after": "1 year",
    "archive_zip_group_by": "month",
    "TestMode": false
  },
  "Targets": [
    {
      "Name": "ZipMonthSource",
      "Path": "data/Source",
      "Enabled": true
    }
  ]
}
