{
  "Defaults": {
    "MaxLogSizeMB": 5,
    "LogRotateCount": 2,
    "OlderThanSeconds": 86400,
    "DateField": "LastWriteTime",
    "Extensions": [".txt"],
    "ArchiveFolder": "../Archive",
    "RetentionEnabled": true,
    "RetentionYears": 7,
    "RetentionAction": "delete",
    "TestMode": false
  },
  "Targets": [
    {
      "Name": "RetentionDeleteSource",
      "Path": "data/Source",
      "Enabled": true
    }
  ]
}
